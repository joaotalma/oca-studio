# Geral: cada frente tem também o seu .gitignore
node_modules/
__pycache__/
.tmp/
*.log
.env
.env.*
.DS_Store
Thumbs.db

# Mídia pesada fica fora do git
*.mp4
*.mov
*.wav
*.mp3
*.m4a
*.flac

# Exceção (decisão do João, 12/11/2026): os vídeos finais aprovados ficam no git, em animacoes/entregas/
!animacoes/entregas/**/*.mp4
