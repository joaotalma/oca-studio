{
  "id": "03-genios",
  "segments": [
    {
      "start": 0.0,
      "end": 4.88,
      "text": "O Davi recebeu uma proposta, discutir com 100 gênios ou com um idiota."
    },
    {
      "start": 4.88,
      "end": 6.56,
      "text": "Pássio, escolheu os gênios."
    },
    {
      "start": 6.56,
      "end": 10.6,
      "text": "100 gênios entraram na sala, sem cadernos, sem óculos."
    },
    {
      "start": 10.6,
      "end": 13.28,
      "text": "Ele falou o argumento, eles pararam, pensaram."
    },
    {
      "start": 13.28,
      "end": 14.6,
      "text": "Um gênio levantou a mão."
    },
    {
      "start": 14.6,
      "end": 17.0,
      "text": "Faz sentido, mas aqui tem um erro."
    },
    {
      "start": 17.0,
      "end": 18.24,
      "text": "O Davi mostrou o dado."
    },
    {
      "start": 18.24,
      "end": 20.2,
      "text": "O gênio respondeu, você tem razão."
    },
    {
      "start": 20.2,
      "end": 22.44,
      "text": "Em 10 minutos, a discussão acabou."
    },
    {
      "start": 22.44,
      "end": 23.84,
      "text": "Ninguém ficou ofendido."
    },
    {
      "start": 23.84,
      "end": 27.08,
      "text": "Aí chegou o idiota, sentou, cruzou os braços."
    },
    {
      "start": 27.08,
      "end": 28.36,
      "text": "O Davi mostrou o dado."
    },
    {
      "start": 28.36,
      "end": 29.28,
      "text": "O idiota falou."
    },
    {
      "start": 29.28,
      "end": 30.44,
      "text": "Isso aí é mentira."
    },
    {
      "start": 30.44,
      "end": 31.44,
      "text": "Mostrou a fonte."
    },
    {
      "start": 31.44,
      "end": 32.52,
      "text": "Fonte comprada."
    },
    {
      "start": 32.52,
      "end": 35.16,
      "text": "Três horas depois, o Davi estava roco."
    },
    {
      "start": 35.16,
      "end": 37.12,
      "text": "O idiota nem tinha piscado."
    },
    {
      "start": 37.12,
      "end": 39.88,
      "text": "Porque gênio discute para descobrir a verdade."
    },
    {
      "start": 39.88,
      "end": 42.12,
      "text": "Idiota discute para não perder."
    },
    {
      "start": 42.12,
      "end": 43.12,
      "text": "Parte 2."
    },
    {
      "start": 43.12,
      "end": 44.92,
      "text": "E se forem 100 idiotas?"
    }
  ],
  "words": 121
}