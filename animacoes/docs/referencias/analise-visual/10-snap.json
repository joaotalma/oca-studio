{
  "id": "10-snap",
  "segments": [
    {
      "start": 0.0,
      "end": 1.0,
      "text": "3. Da Manhã."
    },
    {
      "start": 1.0,
      "end": 4.22,
      "text": "O Clayton acabou de curtir uma foto da Bia."
    },
    {
      "start": 4.22,
      "end": 5.78,
      "text": "De 2019."
    },
    {
      "start": 5.78,
      "end": 8.14,
      "text": "7 anos para trás no perfil dela."
    },
    {
      "start": 8.14,
      "end": 9.14,
      "text": "Ele discurte."
    },
    {
      "start": 9.14,
      "end": 12.82,
      "text": "Tarde demais."
    },
    {
      "start": 12.82,
      "end": 16.38,
      "text": "Eles estudaram juntos, mas não se falavam desde a escola."
    },
    {
      "start": 16.38,
      "end": 20.54,
      "text": "Ele pede desculpa, ela ri e a conversa vai até de manhã."
    },
    {
      "start": 20.54,
      "end": 22.04,
      "text": "Aí vem a pergunta."
    },
    {
      "start": 22.04,
      "end": 25.38,
      "text": "E esse é o Clayton."
    },
    {
      "start": 25.38,
      "end": 26.58,
      "text": "Chinelo com arame."
    },
    {
      "start": 26.58,
      "end": 28.02,
      "text": "Calça com ventilação."
    },
    {
      "start": 28.02,
      "end": 31.3,
      "text": "Um dente que saiu em 2021 e não avisou."
    },
    {
      "start": 31.3,
      "end": 32.3,
      "text": "E o boné."
    },
    {
      "start": 32.3,
      "end": 33.3,
      "text": "Que ele não tira."
    },
    {
      "start": 33.3,
      "end": 34.3,
      "text": "Nunca."
    },
    {
      "start": 34.3,
      "end": 35.3,
      "text": "Primeira tentativa."
    },
    {
      "start": 35.3,
      "end": 36.3,
      "text": "Segunda."
    },
    {
      "start": 36.3,
      "end": 38.32,
      "text": "Terceira, a dona Neide ajudou."
    },
    {
      "start": 38.32,
      "end": 39.58,
      "text": "Até que ele acha."
    },
    {
      "start": 39.58,
      "end": 40.86,
      "text": "Formatura do irmão."
    },
    {
      "start": 40.86,
      "end": 41.98,
      "text": "Terno alugado."
    },
    {
      "start": 41.98,
      "end": 43.98,
      "text": "Uma tarde em 2018."
    },
    {
      "start": 43.98,
      "end": 46.78,
      "text": "A única foto boa da vida dele."
    },
    {
      "start": 46.78,
      "end": 50.68,
      "text": "Ele manda."
    },
    {
      "start": 50.68,
      "end": 53.52,
      "text": "Ela trabalha num navio e volta em 30 dias."
    },
    {
      "start": 53.52,
      "end": 55.72,
      "text": "Ele diz sim."
    },
    {
      "start": 55.72,
      "end": 57.72,
      "text": "Só que ela marcou com esse cara."
    },
    {
      "start": 57.72,
      "end": 59.4,
      "text": "E quem vai é esse."
    },
    {
      "start": 59.4,
      "end": 60.92,
      "text": "30 dias."
    },
    {
      "start": 60.92,
      "end": 62.12,
      "text": "Por onde ele começa?"
    },
    {
      "start": 62.12,
      "end": 63.6,
      "text": "Barba ou dente?"
    },
    {
      "start": 63.6,
      "end": 64.48,
      "text": "Comenta uma palavra."
    }
  ],
  "words": 145
}