{
  "id": "06-ultimo",
  "segments": [
    {
      "start": 0.0,
      "end": 5.2,
      "text": "Imagina pagar no sofá da sala e acordar com o celular vibrando sem parar."
    },
    {
      "start": 5.2,
      "end": 9.4,
      "text": "Na TV ligada, todos os canais mostram a mesma notícia urgente."
    },
    {
      "start": 9.4,
      "end": 13.2,
      "text": "Todos os homens do mundo desapareceram sem deixar rastro."
    },
    {
      "start": 13.2,
      "end": 14.2,
      "text": "Menos um."
    },
    {
      "start": 14.2,
      "end": 17.64,
      "text": "E esse um é você, Mateus, 28 anos."
    },
    {
      "start": 17.64,
      "end": 20.44,
      "text": "Agora o mundo inteiro só faz uma pergunta."
    },
    {
      "start": 20.44,
      "end": 21.64,
      "text": "Onde ele está?"
    },
    {
      "start": 21.64,
      "end": 22.84,
      "text": "Regra número um."
    },
    {
      "start": 22.84,
      "end": 25.2,
      "text": "O seu celular vai te caguetar."
    },
    {
      "start": 25.2,
      "end": 28.36,
      "text": "Mateus joga o celular num caminhão indo para o Paraguai."
    },
    {
      "start": 28.36,
      "end": 32.32,
      "text": "10 minutos depois, 20 viaturas estão seguindo o caminhão."
    },
    {
      "start": 32.32,
      "end": 33.76,
      "text": "Regra número dois."
    },
    {
      "start": 33.76,
      "end": 36.04,
      "text": "Você não pode chamar a atenção."
    },
    {
      "start": 36.04,
      "end": 37.36,
      "text": "A barba vai embora."
    },
    {
      "start": 37.36,
      "end": 39.64,
      "text": "A peruca da irmã, a jaqueta da mãe."
    },
    {
      "start": 39.64,
      "end": 42.68,
      "text": "No espelho, agora tem uma mulher muito alta."
    },
    {
      "start": 42.68,
      "end": 44.84,
      "text": "Com uma voz muito grossa."
    },
    {
      "start": 44.84,
      "end": 46.28,
      "text": "Regra número três."
    },
    {
      "start": 46.28,
      "end": 48.36,
      "text": "A cidade é uma armadilha."
    },
    {
      "start": 48.36,
      "end": 50.76,
      "text": "Em todas as telas, o rosto dele."
    },
    {
      "start": 50.76,
      "end": 51.6,
      "text": "Procurado."
    },
    {
      "start": 51.6,
      "end": 54.32,
      "text": "Recompensa de 5 milhões de dólares."
    },
    {
      "start": 54.32,
      "end": 58.0,
      "text": "Mateus cruza os parques à noite e segue pelos trilhos do trem"
    },
    {
      "start": 58.04,
      "end": 59.56,
      "text": "até sair da cidade."
    },
    {
      "start": 59.56,
      "end": 62.68,
      "text": "No ônibus noturno, uma mulher senta na frente dele."
    },
    {
      "start": 62.68,
      "end": 64.44,
      "text": "Ela olha para as mãos dele."
    },
    {
      "start": 64.44,
      "end": 65.6,
      "text": "Mãos grandes."
    },
    {
      "start": 65.6,
      "end": 69.08,
      "text": "Mateus esconde as mãos devagar nos bolsos da jaqueta"
    },
    {
      "start": 69.08,
      "end": 70.28,
      "text": "e vira para a janela."
    },
    {
      "start": 70.28,
      "end": 73.68,
      "text": "Um ponto depois, ela desce e pega o celular."
    },
    {
      "start": 73.68,
      "end": 74.72,
      "text": "Dia três."
    },
    {
      "start": 74.72,
      "end": 77.56,
      "text": "Uma cabana velha de caçador no meio do mato"
    },
    {
      "start": 77.56,
      "end": 80.24,
      "text": "a 30 quilômetros da cidade mais próxima."
    },
    {
      "start": 80.24,
      "end": 83.52,
      "text": "Uma lareira, sardinha em lata e um rádio velho."
    },
    {
      "start": 83.52,
      "end": 85.72,
      "text": "De hora em hora, o mesmo anúncio."
    },
    {
      "start": 85.8,
      "end": 87.48,
      "text": "Nós só queremos te ajudar."
    },
    {
      "start": 87.48,
      "end": 88.32,
      "text": "Apareça."
    },
    {
      "start": 88.32,
      "end": 91.12,
      "text": "Mateus não acredita em nenhuma palavra."
    },
    {
      "start": 91.12,
      "end": 92.08,
      "text": "Dia sete."
    },
    {
      "start": 92.08,
      "end": 94.76,
      "text": "No meio da madrugada, batidas na porta,"
    },
    {
      "start": 94.76,
      "end": 96.64,
      "text": "Mateus prende a respiração."
    },
    {
      "start": 96.64,
      "end": 97.44,
      "text": "Passos."
    },
    {
      "start": 97.44,
      "end": 99.12,
      "text": "Depois, silêncio."
    },
    {
      "start": 99.12,
      "end": 101.24,
      "text": "De manhã, tem um bilhete na porta."
    },
    {
      "start": 101.24,
      "end": 102.76,
      "text": "Você não é o único."
    },
    {
      "start": 102.76,
      "end": 103.96,
      "text": "Somos dez."
    },
    {
      "start": 103.96,
      "end": 104.92,
      "text": "Rio de Janeiro."
    },
    {
      "start": 104.92,
      "end": 105.6,
      "text": "O porto."
    },
    {
      "start": 105.6,
      "end": 107.36,
      "text": "Sesta-feira, meia-noite."
    },
    {
      "start": 107.36,
      "end": 108.92,
      "text": "Mateus vira o bilhete."
    },
    {
      "start": 108.92,
      "end": 110.56,
      "text": "No verso, um endereço."
    },
    {
      "start": 110.56,
      "end": 112.36,
      "text": "O apartamento da mãe dele."
    },
    {
      "start": 112.36,
      "end": 113.36,
      "text": "O que você faria?"
    }
  ],
  "words": 295
}